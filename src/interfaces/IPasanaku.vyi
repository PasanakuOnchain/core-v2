# pragma version ==0.4.3
"""
@title `IPasanaku` - Pasanaku interface
@custom:contract-name IPasanaku
@license GNU Affero General Public License v3.0 only
@author Rafael Abuawad <x.com/rabuawad_>
"""


event CollateralDeposited:
    account: indexed(address)
    asset: indexed(address)
    amount: uint256
    balance_after: uint256


event CollateralWithdrawn:
    account: indexed(address)
    asset: indexed(address)
    amount: uint256
    balance_after: uint256


event PasanakuCreated:
    token_id: indexed(uint256)
    asset: indexed(address)
    amount: uint256


event PasanakuJoined:
    token_id: indexed(uint256)
    account: indexed(address)
    participant_count: uint256


event PasanakuStarted:
    token_id: indexed(uint256)
    asset: address
    amount: uint256
    started_at: uint256


event TickDepositMarked:
    participant: indexed(address)
    token_id: indexed(uint256)
    tick_index: uint256
    asset: address
    amount: uint256


event PasanakuTicked:
    token_id: indexed(uint256)
    tick_index: uint256
    recipient: indexed(address)
    asset: address
    amount: uint256
    updated_at: uint256


event PasanakuEnded:
    token_id: indexed(uint256)
    asset: indexed(address)
    amount: uint256
    ended_at: uint256


event Skimmed:
    account: indexed(address)
    asset: indexed(address)
    amount: uint256


event Recovered:
    account: indexed(address)
    asset: indexed(address)
    amount: uint256


struct Pasanaku:
    token_id: uint256
    asset: address
    amount: uint256
    participants: DynArray[address, 12]
    active_participant: uint256
    started: uint256
    updated: uint256
    ended: uint256
