contract LayoutOngoing is ILayout {
    function layout(IPasanaku.RotatingSavings memory rs) external view returns (string memory) {
        return string.concat("data:image/svg+xml;base64,", Base64.encode(bytes(_imageData(rs))));
    }

    function _imageData(IPasanaku.RotatingSavings memory rs) private view returns (string memory) {
        address asset = rs.asset;
        uint256 decimals = uint256(IERC20Metadata(asset).decimals());
        string memory symbol = IERC20Metadata(asset).symbol();
        uint256 players = rs.participants.length;
        uint256 currentRound = rs.currentIndex + 1;
        uint256 totalRounds = players;
        uint256 playersDeposited = rs.totalDeposited / rs.amount;
        uint256 playersExpected = players - 1;
        uint256 totalAmount = rs.totalDeposited;

        return string.concat(
            '<?xml version="1.0" encoding="UTF-8"?> <svg fill="none" viewBox="0 0 720 720" xmlns="http://www.w3.org/2000/svg"><defs><style>@font-face { font-family: "Fifties"; src: url("data:font/truetype;charset=utf-8;base64,") format("truetype"); } .fifties { font-family: "Fifties", sans-serif; } .sans { font-family: "Inter", Arial, Helvetica, sans-serif; }</style></defs><g clip-path="url(#clip0_2_33)"><rect width="720" height="720" fill="url(#paint0_radial_2_33)"/><circle cx="605" cy="645" r="215" fill="url(#paint1_radial_2_33)"/><circle cx="120" cy="590" r="230" fill="url(#paint2_radial_2_33)"/><circle cx="240" cy="140" r="130" fill="url(#paint3_radial_2_33)"/><g filter="url(#filter0_d_2_33)" opacity=".52" shape-rendering="crispEdges"><rect x="370" y="503" width="270" height="105" rx="16" fill="url(#paint4_linear_2_33)"/><rect x="371" y="504" width="268" height="103" rx="15" stroke="#fff" stroke-opacity=".53" stroke-width="2"/></g><text class="sans" fill="white" font-size="32" font-weight="bold" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="410" y="579.136">',
            symbol,
            '</tspan> </text><text class="sans" fill="white" font-size="20" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="410" y="540.273">Currency</tspan> </text><g filter="url(#filter1_d_2_33)" opacity=".52" shape-rendering="crispEdges"><rect x="80" y="503" width="270" height="108" rx="16" fill="url(#paint5_linear_2_33)"/><rect x="81" y="504" width="268" height="106" rx="15" stroke="#fff" stroke-opacity=".53" stroke-width="2"/></g><text class="sans" fill="white" font-size="32" font-weight="bold" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="120" y="579.136">',
            LibLayoutUtils.formatWithDecimals(totalAmount, decimals),
            '</tspan> </text><text class="sans" fill="white" font-size="20" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="120" y="540.273">Total Amount</tspan> </text><g filter="url(#filter2_d_2_33)" opacity=".52" shape-rendering="crispEdges"><rect x="370" y="383" width="270" height="105" rx="16" fill="url(#paint6_linear_2_33)"/><rect x="371" y="384" width="268" height="103" rx="15" stroke="#fff" stroke-opacity=".53" stroke-width="2"/></g><text class="sans" fill="white" font-size="32" font-weight="bold" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="410" y="459.136">',
            LibString.toString(playersDeposited),
            " of ",
            LibString.toString(playersExpected),
            '</tspan> </text><text class="sans" fill="white" font-size="20" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="410" y="420.273">Deposited</tspan> </text><g filter="url(#filter3_d_2_33)" opacity=".52" shape-rendering="crispEdges"><rect x="80" y="383" width="270" height="108" rx="16" fill="url(#paint7_linear_2_33)"/><rect x="81" y="384" width="268" height="106" rx="15" stroke="#fff" stroke-opacity=".53" stroke-width="2"/></g><text class="sans" fill="white" font-size="32" font-weight="bold" letter-spacing="0em" style="white-space:pre" xml:space="preserve"> <tspan x="120" y="459.136">',
            LibString.toString(currentRound),
            "/",
            LibString.toString(totalRounds),
